# xpenses server environment — copy to .env and fill in:
#   cp .env.example .env
# .env is gitignored; never commit real secrets. This template is safe to commit.
# config/env.js validates every key below is present at boot and fails fast if not.

# development | production
# production enables: Secure cookies, trust proxy, in-process daily cron, and
# same-origin static serving of the built frontend from server/public.
NODE_ENV=production

# --- MySQL (Hostinger-hosted in prod, local for dev) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=xpense

# --- Secrets (generate fresh per environment; rotate if exposed) ---

# bcrypt hash of the single app login password. Generate:
#   node -e "console.log(require('bcrypt').hashSync('your-strong-password', 12))"
PASSWORD_HASH=

# JWT signing secret — random 64-byte hex. Generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Shared secret for the Plan-B cron endpoint (POST /api/cron/run) — random hex.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SHARED_SECRET=
